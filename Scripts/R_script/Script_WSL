
# Create project directory


mkdir -p ~/shotgun_seq/data
cd ~/shotgun_seq/data


# Download SRA file

prefetch SRR32570884

# Convert SRA to FASTQ


fasterq-dump SRR32570884

# Run FastQC


fastqc SRR32570884.fastq


# Create smaller subset for testing


head -400000 SRR32570884.fastq > SRR32570884_sub.fastq


# Download Kraken2 database


wget https://genome-idx.s3.amazonaws.com/kraken/k2_standard_08gb_20250402.tar.gz


# Extract Kraken2 database


tar -xvzf k2_standard_08gb_20250402.tar.gz


# Run Kraken2 taxonomic classification


kraken2 \
--db . \
--report report.txt \
SRR32570884.fastq \
> kraken_output.txt


# Filter viral taxa from report


grep "Viruses" report.txt > virusfiltered.txt

#similarly filter bacteria  grep -i bacteria report.txt >bacteriafiltered.txt

